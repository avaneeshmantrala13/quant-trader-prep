# =============================================================================
# Quant Trader Prep — environment configuration
# =============================================================================
# The app is LOCAL-FIRST by default: with NO env file at all it builds and runs
# entirely in the browser (accounts + progress in localStorage). You only need
# the variables below to switch on the AWS Free-Tier backend (real accounts +
# cross-device progress sync).
#
# To enable AWS: run `./infra/deploy.sh` (it writes a filled-in `.env.local`
# for you), or copy this file to `.env.local` and paste the values from the
# CloudFormation stack outputs. See `infra/AWS_SETUP.md` for the full runbook.
# -----------------------------------------------------------------------------

# ---- Backend selector -------------------------------------------------------
# "local" (or unset) = local-first default. "aws" = Cognito + DynamoDB backend.
VITE_STORAGE_BACKEND=local

# ---- AWS backend config (REQUIRED only when VITE_STORAGE_BACKEND=aws) --------
# All values below are public / client-safe. NO secrets ever go here.
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_IDENTITY_POOL_ID=us-east-1:00000000-0000-0000-0000-000000000000
VITE_DYNAMODB_TABLE=quant-trader-prep-progress

# ---- Google federated sign-in (OPTIONAL — only if you configured a Google IdP)
# Master switch for the "Continue with Google" button. Default OFF: the button
# is HIDDEN unless this is "on" AND the two Cognito Hosted-UI vars below are set.
# `infra/deploy.sh` flips this to "on" automatically when you deploy with a
# GOOGLE_CLIENT_ID (which is what actually creates the Google IdP in the pool),
# so the button only appears once Google federation truly exists. Do NOT hardcode
# it on — a Cognito domain always exists even with no Google IdP, and a stray
# "on" would send users to a Hosted UI that errors "Login option is not available".
VITE_GOOGLE_AUTH=off
# The Cognito Hosted-UI domain and the app's OAuth redirect URI.
VITE_COGNITO_DOMAIN=quant-trader-prep-123456789012.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/

# ---- Privileged API (OPTIONAL — server-only writes via Lambda/API Gateway) ---
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# ---- Optional AI "flavor / open-ended" layer (OFF BY DEFAULT) ---------------
# This layer adds LLM-reskinned variety + conservative open-ended items ON TOP
# OF the parametric + exact-verifier backbone. It is verifier-gated (a wrong
# answer can never be surfaced) and entirely optional. Leave VITE_AI_LAYER unset
# (or "off") and the app builds/runs local-first with NO LLM anything and no
# button. The LLM API key is NEVER here — it lives only in SSM, read by a Lambda
# (see infra/AI_SETUP.md). NOTE: the LLM API is external + PAID (not AWS Free-Tier).
#
# "on" enables the layer (the "✨ Fresh variant" action can appear). Default off.
VITE_AI_LAYER=off
# Base URL of the AI Lambda endpoint (from the AI stack output). Falls back to
# VITE_API_BASE_URL if unset. The client POSTs to `${VITE_AI_ENDPOINT}/ai`.
VITE_AI_ENDPOINT=https://yyyyyyyyyy.execute-api.us-east-1.amazonaws.com
# Informational only (which provider the server Lambda is configured for).
VITE_AI_PROVIDER=openai
# Local-dev stub: "on" makes the client return the ORIGINAL prompt unchanged
# with NO network/key (handy for wiring the UI). Never surfaces a wrong answer.
VITE_AI_STUB=off
